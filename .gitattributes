# This tree is cross-compiled from Linux (WSL or a MiSTer). With
# core.autocrlf=true on Windows, a checkout produces CRLF everywhere, and:
#
#   - GNU make reads `BASE = arm-none-linux-gnueabihf<CR>`, so CC becomes
#     `arm-none-linux-gnueabihf<CR>-gcc` and the build dies with
#     "command not found"
#   - every .sh dies with "bad interpreter: /bin/bash^M"
#
# Force LF in the working tree regardless of the user's autocrlf setting.

* text=auto eol=lf

*.sv   text eol=lf
*.v    text eol=lf
*.vh   text eol=lf
*.vhd  text eol=lf
*.qip  text eol=lf
*.qsf  text eol=lf
*.qpf  text eol=lf
*.sdc  text eol=lf
*.tcl  text eol=lf
*.srf  text eol=lf
*.mif  text eol=lf
*.asm  text eol=lf
*.cpp  text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf
Makefile text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.so   binary
*.rbf  binary
*.sof  binary
*.rom  binary
*.xlsx binary
releases/** binary
