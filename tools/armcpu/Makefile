# armcpu: MEASUREMENT ONLY, see armcpu.c. Same toolchain as Main and latprobe
# (setup_default_toolchain.sh); static so it runs on any MiSTer image.
# musashi/ is Musashi v4.60 (MIT, see musashi/readme.txt and UPSTREAM)
# unmodified, with m68kops.c/h generated by its m68kmake and committed, so the
# cross build needs no host tool; armcpu_conf.h is its m68kconf.h with RESET
# emulation on.
# moira/ is Moira (MIT, see moira/LICENSE and UPSTREAM), vAmiga's core, with
# MoiraConfig.h set for speed; `make armcpu-moira` builds armcpu.c on it
# through cpu_moira.cpp, which puts it behind the Musashi calls armcpu.c makes.
BASE   ?= arm-none-linux-gnueabihf
CC      = $(BASE)-gcc
CXX     = $(BASE)-g++
CFLAGS  = -O2 -Wall -std=gnu99 -I. -Imusashi -DMUSASHI_CNF='"armcpu_conf.h"'
# the Cortex-A9, ARM state, and whole-program optimisation so Musashi's
# memory callbacks can be inlined into the opcode handlers
TUNE   ?= -O3 -mcpu=cortex-a9 -marm -flto
CFLAGS += $(TUNE)
SRCS    = armcpu.c musashi/m68kcpu.c musashi/m68kops.c musashi/m68kdasm.c musashi/softfloat/softfloat.c
MOIRA   = moira/Moira.cpp moira/MoiraCore68000.cpp moira/MoiraCore68010.cpp           moira/MoiraCore68020.cpp moira/MoiraDebugger.cpp
CXXFLAGS = -O2 -std=c++20 -Wall -Wno-unused-parameter -I. -Imusashi -Imoira $(TUNE)

armcpu: $(SRCS) armcpu_conf.h
	$(CC) $(CFLAGS) -static -o $@ $(SRCS) -lm

armcpu-moira: armcpu.c cpu_moira.cpp $(MOIRA) moira/*.h
	$(CC) $(CFLAGS) -DARMCPU_CORE='"Moira"' -c -o armcpu-moira.o armcpu.c
	$(CXX) $(CXXFLAGS) -static -o $@ armcpu-moira.o cpu_moira.cpp $(MOIRA) -lm
	rm -f armcpu-moira.o

clean:
	rm -f armcpu armcpu-moira armcpu-moira.o

.PHONY: clean
