# ---- AmigaCD project ----

# Serena project state
.serena/cache/

# Upstream clones (fetched via scripts/fetch-upstream.sh, not tracked here)
/upstream/*/

# ---- Main_MiSTer (inherited from cd32-main/amiga-console) ----

# ignore backup files
*~

# ignore vi swapfiles
.*.swp

# ignore compiled python
*pyc

# ignore some backup files
*bak

# ignore some c files
*\.o
*\.d

# ignore dropbox files
.dropbox.attr

# ignore directories
Debug
gcc-*

host
*.lst
*.elf
*.map
*.user
.vs
MiSTer
/bin

# ---- Quartus / core build artefacts ----
*.rbf
*.sof
*.qar
*.rpt
*.summary
db/
incremental_db/
output_files/
simulation/
greybox_tmp/

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
output/

# Diagnostic tarballs pulled off the MiSTer by scripts/collect-diag.sh.
# Machine state, not source: they carry the device's config and logs.
diag/

# Icarus bench artefacts. The rtl-sim workflow compiles into build/ and some
# benches dump a .vcd beside themselves; CI builds in a fresh checkout so these
# only appear after running the suite locally -- which is exactly when a
# `git add -A` sweeps them in.
build/
*.vcd
